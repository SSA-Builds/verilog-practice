
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Verilog: Compile and Run",
            "type": "shell",
            "command": "iverilog -g2012 -o \"${fileDirname}\\${fileBasenameNoExtension}.vvp\" \"${file}\"; if ($LASTEXITCODE -eq 0) { vvp \"${fileDirname}\\${fileBasenameNoExtension}.vvp\" }",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
